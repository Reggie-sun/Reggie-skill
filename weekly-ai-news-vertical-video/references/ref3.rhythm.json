    "lines": [
      {
        "start": 1.0,
        "text": "2分钟看完一周AI大事",
        "end": 3.0
      },
      {
        "start": 3.0,
        "text": "Google发布下一代旗舰模型「Gemini 4 Argon」",
        "end": 5.0
      },
      {
        "start": 5.0,
        "text": "数学、科学、知识工作",
        "end": 6.0
      },
      {
        "start": 6.0,
        "text": "编程和电脑操作能力",
        "end": 8.0
      },
      {
        "start": 8.0,
        "text": "全面超越Claude Opus 5.5和GPT-6 Astra",
        "end": 10.0
      },
      {
        "start": 10.0,
        "text": "重夺地表SOTA",
        "end": 11.0
      },
      {
        "start": 11.0,
        "text": "最大亮点是1M tokens直出",
        "end": 13.0
      },
      {
        "start": 13.0,
        "text": "幻觉率压到历史最低",
        "end": 15.0
      },
      {
        "start": 15.0,
        "text": "一次回答能甩出整本小说",
        "end": 17.0
      },
      {
        "start": 17.0,
        "text": "或完整代码库",
        "end": 18.0
      },
      {
        "start": 18.0,
        "text": "第三方测试「Gemini 4 Argon High」",
        "end": 20.0
      },
      {
        "start": 20.0,
        "text": "打平「GPT-6 Astra Max」",
        "end": 22.0
      },
      {
        "start": 22.0,
        "text": "成本爆砍4成",
        "end": 23.0
      },
      {
        "start": 23.0,
        "text": "「Claude Fable 5.5」开启灰度测试",
        "end": 25.0
      },
      {
        "start": 25.0,
        "text": "Claude 5.5系列王炸模型即将亮相",
        "end": 28.0
      },
      {
        "start": 28.0,
        "text": "动效能力逆天",
        "end": 29.0
      },
      {
        "start": 29.0,
        "text": "一句话直出5分钟",
        "end": 30.0
      },
      {
        "start": 30.0,
        "text": "带音乐带转场的动画视频",
        "end": 32.0
      },
      {
        "start": 32.0,
        "text": "语言模型降维打击视频模型",
        "end": 34.0
      },
      {
        "start": 34.0,
        "text": "视频后期彻底变天",
        "end": 36.0
      },
      {
        "start": 36.0,
        "text": "Anthropic上线「Claude Sonnet 5.5」",
        "end": 38.0
      },
      {
        "start": 38.0,
        "text": "综合智商仅次于Claude Opus 5.5",
        "end": 40.0
      },
      {
        "start": 40.0,
        "text": "5.5系列美学水平在线",
        "end": 42.0
      },
      {
        "start": 42.0,
        "text": "做视频的能力接近Claude Opus 5.5",
        "end": 44.0
      },
      {
        "start": 44.0,
        "text": "成本只要一半",
        "end": 45.0
      },
      {
        "start": 45.0,
        "text": "OpenAI上线「GPT-6.1 Sol」",
        "end": 47.0
      },
      {
        "start": 47.0,
        "text": "能力打平GPT-6 Astra",
        "end": 48.0
      },
      {
        "start": 48.0,
        "text": "成本只要1/5",
        "end": 49.0
      },
      {
        "start": 49.0,
        "text": "「GPT-6.1 Astra」没有通过安全测试",
        "end": 52.0
      },
      {
        "start": 52.0,
        "text": "被取消发布",
        "end": 53.0
      },
      {
        "start": 53.0,
        "text": "年度SOTA大模型之争已经白热化",
        "end": 55.0
      },
      {
        "start": 55.0,
        "text": "OpenAI推出全天候智能体「dots」",
        "end": 57.0
      },
      {
        "start": 57.0,
        "text": "由「GPT-6 Astra」驱动",
        "end": 58.0
      },
      {
        "start": 58.0,
        "text": "自带云电脑",
        "end": 59.0
      },
      {
        "start": 59.0,
        "text": "能操作4,000多个软件",
        "end": 61.0
      },
      {
        "start": 61.0,
        "text": "7*24小时干活",
        "end": 63.0
      },
      {
        "start": 63.0,
        "text": "还能打语音给它派活",
        "end": 65.0
      },
      {
        "start": 65.0,
        "text": "个人AI助理成为新的Killer App",
        "end": 67.0
      },
      {
        "start": 67.0,
        "text": "工程师推出开源版dots「Open dot」",
        "end": 69.0
      },
      {
        "start": 69.0,
        "text": "每个人都能部署自己的私人助理",
        "end": 71.0
      },
      {
        "start": 71.0,
        "text": "工程师推出SOTA AI助理「Fo」",
        "end": 73.0
      },
      {
        "start": 73.0,
        "text": "自带邮箱电话",
        "end": 74.0
      },
      {
        "start": 74.0,
        "text": "能帮你约理发叫维修",
        "end": 76.0
      },
      {
        "start": 76.0,
        "text": "搞不定的任务还会在线摇人",
        "end": 78.0
      },
      {
        "start": 78.0,
        "text": "呼叫人类",
        "end": 79.0
      },
      {
        "start": 79.0,
        "text": "真实任务成功率比",
        "end": 80.0
      },
      {
        "start": 80.0,
        "text": "其他AI助理高七成",
        "end": 82.0
      },
      {
        "start": 82.0,
        "text": "研究员开源能自我进化的智能体「Raven」",
        "end": 84.0
      },
      {
        "start": 84.0,
        "text": "用Agent管理Agent（Harness in Harness）",
        "end": 86.0
      },
      {
        "start": 86.0,
        "text": "4天搓出FPS游戏",
        "end": 88.0
      },
      {
        "start": 88.0,
        "text": "还做了宣发官网和海报",
        "end": 89.0
      },
      {
        "start": 89.0,
        "text": "研究员开源视觉版Jev「Valen」",
        "end": 91.0
      },
      {
        "start": 91.0,
        "text": "看到画面直接做决策",
        "end": 93.0
      },
      {
        "start": 93.0,
        "text": "能用来打游戏",
        "end": 94.0
      },
      {
        "start": 94.0,
        "text": "操作电脑和机器人",
        "end": 95.0
      },
      {
        "start": 95.0,
        "text": "工程师开发出iPhone连接器「Tapkit」",
        "end": 97.0
      },
      {
        "start": 97.0,
        "text": "让Codex接管手机屏幕",
        "end": 99.0
      },
      {
        "start": 99.0,
        "text": "能用来聊天抢票",
        "end": 101.0
      },
      {
        "start": 101.0,
        "text": "AI六巨头签署超级智能协议",
        "end": 103.0
      },
      {
        "start": 103.0,
        "text": "AI从此更名「SI」",
        "end": 105.0
      },
      {
        "start": 105.0,
        "text": "前沿模型发布前自愿接受外部审计",
        "end": 108.0
      },
      {
        "start": 108.0,
        "text": "AI科研再迎突破",
        "end": 109.0
      },
      {
        "start": 109.0,
        "text": "「GPT-6 Astra」成功找到「格拉德猜想」新反例",
        "end": 113.0
      },
      {
        "start": 113.0,
        "text": "Ideogram上线SOTA图像编辑模型「Ideogram 4.5」",
        "end": 115.0
      },
      {
        "start": 115.0,
        "text": "能精准修改任意元素",
        "end": 117.0
      },
      {
        "start": 117.0,
        "text": "多轮重绘也不退化",
        "end": 119.0
      },
      {
        "start": 119.0,
        "text": "开源权重即将放出",
        "end": 120.0
      },
      {
        "start": 120.0,
        "text": "Black Forest上线图像编辑模型「FLUX 3 Image」",
        "end": 122.0
      },
      {
        "start": 122.0,
        "text": "局部重绘不碰其他区域",
        "end": 124.0
      },
      {
        "start": 124.0,
        "text": "还能超分到4K",
        "end": 125.0
      },
      {
        "start": 125.0,
        "text": "几周后开源",
        "end": 126.0
      },
      {
        "start": 126.0,
        "text": "Tavus发布SOTA实时数字人模型「Griffin」",
        "end": 129.0
      },
      {
        "start": 129.0,
        "text": "在视频通话中有48%的",
        "end": 131.0
      },
      {
        "start": 131.0,
        "text": "用户没认出来是AI",
        "end": 133.0
      },
      {
        "start": 133.0,
        "text": "能用来做视频直播",
        "end": 134.0
      },
      {
        "start": 134.0,
        "text": "口语陪练和模拟面试",
        "end": 136.0
      },
      {
        "start": 136.0,
        "text": "研究员开源3D重建模型「Point2Part」",
        "end": 138.0
      },
      {
        "start": 138.0,
        "text": "给它一张图片",
        "end": 139.0
      },
      {
        "start": 139.0,
        "text": "就能拆分出干净的零件",
        "end": 141.0
      },
      {
        "start": 141.0,
        "text": "还能严丝合缝拼回去",
        "end": 143.0
      },
      {
        "start": 143.0,
        "text": "研究员开源4D世界模型「InSpatio-World 1.5」",
        "end": 145.0
      },
      {
        "start": 145.0,
        "text": "能指定镜头位置和运镜",
        "end": 147.0
      },
      {
        "start": 147.0,
        "text": "能用来做分镜预演",
        "end": 148.0
      },
      {
        "start": 148.0,
        "text": "普通显卡可运行",
        "end": 149.0
      },
      {
        "start": 149.0,
        "text": "英伟达开源视频超分模型「SoL-Refiner」",
        "end": 151.0
      },
      {
        "start": 151.0,
        "text": "AI生成的视频直接补到4K",
        "end": 154.0
      },
      {
        "start": 154.0,
        "text": "纹理细节拉满",
        "end": 155.0
      },
      {
        "start": 155.0,
        "text": "搞AI创作的同学狠狠码住",
        "end": 157.0
      },
      {
        "start": 157.0,
        "text": "研究员开源视频加速Lora「DMAD」",
        "end": 159.0
      },
      {
        "start": 159.0,
        "text": "50步推理蒸馏成4步",
        "end": 161.0
      },
      {
        "start": 161.0,
        "text": "生成速度提高6倍",
        "end": 162.0
      },
      {
        "start": 162.0,
        "text": "画质差异不大",
        "end": 163.0
      },
      {
        "start": 163.0,
        "text": "ElevenLabs上线SOTA语音合成模型「Eleven v4」",
        "end": 166.0
      },
      {
        "start": 166.0,
        "text": "给它台词就能直接演戏",
        "end": 168.0
      },
      {
        "start": 168.0,
        "text": "复杂情绪也能稳稳接住",
        "end": 169.0
      },
      {
        "start": 169.0,
        "text": "微软发布「MAI-Transcribe-2-Streaming」",
        "end": 172.0
      },
      {
        "start": 172.0,
        "text": "60种语言",
        "end": 173.0
      },
      {
        "start": 173.0,
        "text": "百毫秒识别",
        "end": 174.0
      },
      {
        "start": 174.0,
        "text": "人还在说话",
        "end": 175.0
      },
      {
        "start": 175.0,
        "text": "字幕已经跟上了",
        "end": 176.0
      },
      {
        "start": 176.0,
        "text": "研究员开源本地语音识别模型「Phonon-2」（164MB）",
        "end": 178.0
      },
      {
        "start": 178.0,
        "text": "20秒转录一小时录音",
        "end": 180.0
      },
      {
        "start": 180.0,
        "text": "准确率比Whisper高10倍",
        "end": 182.0
      },
      {
        "start": 182.0,
        "text": "Google的「Project Suncatcher」发射成功",
        "end": 184.0
      },
      {
        "start": 184.0,
        "text": "AI芯片已送上太空",
        "end": 186.0
      },
      {
        "start": 186.0,
        "text": "用来验证TPU的抗和温差表现",
        "end": 189.0
      },
      {
        "start": 189.0,
        "text": "AI算力竞赛已打到外太空",
        "end": 191.166667
      }
    ]
  },
